{
  "name": "encryptic-movies-setup",
  "version": "1.0.7",
  "description": "Encryptic Movies — custom setup wizard",
  "main": "main.js",
  "author": {
    "name": "Joe",
    "email": "Longno242@users.noreply.github.com"
  },
  "license": "GPL-3.0",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "^41.10.3",
    "electron-builder": "^26.15.7"
  },
  "overrides": {
    "brace-expansion": "^5.0.7",
    "js-yaml": "^4.3.1",
    "undici": "^6.28.0",
    "tar": "^7.5.16",
    "form-data": "^4.0.6",
    "tmp": "^0.2.6"
  },
  "build": {
    "appId": "com.encryptic.movies.setup",
    "productName": "Encryptic Movies Setup",
    "asar": true,
    "compression": "normal",
    "directories": {
      "output": "../dist",
      "buildResources": "../build"
    },
    "files": [
      "main.js",
      "preload.js",
      "wizard.js",
      "installerEngine.js",
      "posterFetch.js",
      "spotlightMovies.js",
      "updateCheck.js",
      "updateConfig.js",
      {
        "from": "../github.config.json",
        "to": "github.config.json"
      },
      "index.html",
      "installer.css",
      "assets/**/*",
      "package.json",
      "!test-*.js",
      "!cachePostersToDisk.js",
      "!payload/**"
    ],
    "extraResources": [
      {
        "from": "payload",
        "to": "payload",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "../public/encryptic-logo.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Encryptic Movies Setup.${ext}"
    },
    "portable": {
      "artifactName": "Encryptic Movies Setup.${ext}"
    }
  }
}
